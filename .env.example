# Required
ANTHROPIC_API_KEY=sk-ant-...

# Agent key from Dovilo (AI Agents > New agent, assign the project). The key
# is shown only once: copy it straight here. Never commit it.
DOVILO_AGENT_KEY=dvl_agent_...

# Signing secret of the project's webhook (List settings > Webhooks >
# "Generate signing secret"). The plaintext is shown only once: copy it
# straight here. If unset, signature verification is DISABLED (dev only,
# not safe for anything else).
DOVILO_WEBHOOK_SECRET=

# Optional: the Agents MCP endpoint (defaults to production)
# DOVILO_MCP_URL=https://dovilo.app/mcp/agents
